# Optional for the synthetic demo. Use your own public-client app for live collection.
AZAUDIT_AZURE_CLIENT_ID=
AZAUDIT_AZURE_TENANT_ID=common
AZAUDIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AZAUDIT_DATABASE_URL=sqlite+aiosqlite:///./azaudit.db
AZAUDIT_FIELD_ENCRYPTION_KEY_PATH=./azaudit.key
AZAUDIT_LOCAL_UNLOCK_KEY_PATH=./workbench-unlock.key
AZAUDIT_DEBUG=false
AZAUDIT_PORT=8000
# Setting a key enables explicitly triggered external AI processing.
AZAUDIT_OPENAI_API_KEY=
AZAUDIT_OPENAI_MODEL=gpt-4.1-mini
